{
  "name": "filing-agent",
  "version": "0.1.0",
  "description": "A local tool-calling document classifier with deterministic validation, bounded execution and diagnostic receipts. Produces checked filing decisions without moving documents.",
  "type": "module",
  "license": "MIT",
  "author": "Mithun Das",
  "repository": {
    "type": "git",
    "url": "https://github.com/mithundas79/filing-agent.git"
  },
  "bin": {
    "filing-agent": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "pretest": "npm run build",
    "typecheck": "tsc -p tsconfig.check.json",
    "test:integration": "npm run build && vitest run test/http.integration.test.ts",
    "stub": "tsx scripts/provider-stub.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
